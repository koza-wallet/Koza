datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Core Domain Models
model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String?
  image            String?
  subscriptionTier String         @default("FREE") // FREE or PRO
  createdAt        DateTime       @default(now())
  
  pushSubscription String?
  isReminderOn     Boolean        @default(false)
  
  wallets          Wallet[]
  categories       Category[]
  pockets          Pocket[]
  memberships      WalletMember[]
  transactions     Transaction[]
  debts            Debt[]
}

model Wallet {
  id           String         @id @default(cuid())
  name         String
  icon         String         @default("account_balance_wallet")
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  
  members      WalletMember[]
  transactions Transaction[]
}

model WalletMember {
  id       String @id @default(cuid())
  walletId String
  userId   String
  role     String @default("VIEWER") // VIEWER, EDITOR, OWNER

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([walletId, userId])
}

model Category {
  id       String  @id @default(cuid())
  name     String
  fullName String
  icon     String
  bg       String
  text     String
  type     String  // income, expense, both
  userId   String? // null means global/default category
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            String   @id @default(cuid())
  title         String
  amount        Float
  note          String?
  date          DateTime
  direction     String   // income or expense
  paymentMethod String
  createdAt     DateTime @default(now())

  // Multi-currency support
  currencyCode  String @default("IDR")
  exchangeRate  Float  @default(1.0)
  
  walletId      String
  wallet        Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  categoryId    String // ID of category (either global or custom)
  
  debtId        String?
  debt          Debt?  @relation(fields: [debtId], references: [id], onDelete: SetNull)
  
  userId        String // creator
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pocket {
  id             String   @id @default(cuid())
  name           String
  targetAmount   Float
  currentBalance Float    @default(0)
  color          String   @default("bg-primary")
  icon           String   @default("savings")
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Debt {
  id              String   @id @default(cuid())
  type            String   // "HUTANG" or "PIUTANG"
  contactName     String   // Nama teman/entitas
  amount          Float    // Nominal pinjaman awal
  remainingAmount Float    // Sisa yang harus dibayar
  status          String   @default("UNPAID") // UNPAID, PARTIAL, PAID
  dueDate         DateTime? 
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  transactions    Transaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
